# FilaSaúde Brasil — desenvolvimento local
# Copiar para .env na raiz — nunca commitar secrets reais

NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:8000
APP_PORT=8000
NEXT_PUBLIC_API_URL=http://localhost:8000

# PostgreSQL + PostGIS
DATABASE_URL=postgresql://filasaude:filasaude@localhost:5432/filasaude?sslmode=disable
POSTGRES_USER=filasaude
POSTGRES_PASSWORD=filasaude
POSTGRES_DB=filasaude
POSTGRES_PORT=5432

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379

# OSRM (dev stub — profile routing; substituir por OSRM real em CARD-007)
OSRM_BASE_URL=http://localhost:5000
OSRM_PORT=5000

# Google Maps Platform (obter em Google Cloud Console)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_SERVER_KEY=

# Auth admin (painel integrações)
JWT_SECRET=change-me-in-production
JWT_EXPIRES_MINUTES=480

# Ingestão
INGESTION_INTERVAL_SECONDS=300
MOCK_DATA_ENABLED=true

# Logging
LOG_LEVEL=info

# Cards / issue tracking (provider markdown — sem secrets)
# GITHUB_TOKEN=
# JIRA_BASE_URL=
